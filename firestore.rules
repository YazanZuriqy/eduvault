rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // لا وجود لدوال سحابية على خطة Spark، فلا يمكن ضبط Custom Claims؛ الدور يُقرأ مباشرة من مستند المستخدم.
    function isTeacher() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    // المالك معلّم موسوم يدويًا بـ isOwner، هو الوحيد المخوّل بتوليد أكواد دعوة معلّمين جدد.
    function isOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isTeacher());
      allow create: if request.auth != null && (
        (isTeacher() && request.resource.data.role == 'student') ||
        (request.auth.uid == userId && request.resource.data.role == 'student') ||
        // معلّم جديد: يُشترط كود دعوة صالح وغير مستخدم مرتبط بالبريد نفسه (بوابة مكافحة التسلل).
        (request.auth.uid == userId && request.resource.data.role == 'teacher' &&
          'teacherInviteCode' in request.resource.data &&
          exists(/databases/$(database)/documents/teacherInvites/$(request.resource.data.teacherInviteCode)) &&
          get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.teacherInviteCode)).data.email == request.resource.data.email &&
          get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.teacherInviteCode)).data.used == false)
      );
      allow update: if request.auth != null && (
        (isTeacher() && resource.data.role == 'student' && request.resource.data.role == 'student') ||
        (request.auth.uid == userId && resource.data.role == 'teacher') ||
        (request.auth.uid == userId && resource.data.role == 'student' && (
          // تفعيل الحساب بعد أول دخول (استبدال كلمة المرور المؤقتة).
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activationPending']) ||
          // الربط الأول بجهاز أساسي: لا يوجد جهاز أساسي مسجّل بعد (غائب أو null).
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primaryDeviceId', 'biometricLocked']) &&
            (!('primaryDeviceId' in resource.data) || resource.data.primaryDeviceId == null)) ||
          // اعتماد جهاز ثانوي أثناء نافذة سماح فتحها المعلّم صراحةً.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secondaryDeviceId', 'secondaryDeviceWindowOpen']) &&
            resource.data.secondaryDeviceWindowOpen == true)
        ))
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isTeacher());
    }
    match /studentCredentials/{studentId} {
      allow read, write: if isTeacher();
    }
    match /studentInvites/{code} {
      // القراءة بمعرّف الرمز مباحة للجميع (نمط "رابط قدرة" قبل تسجيل دخول الطالب نفسه)، لكن سرد كل
      // الدعوات مقصور على المعلّم كي لا يتمكن أحد من تصفّح الأكواد المعلّقة لطلاب آخرين.
      allow get: if true;
      allow list: if isTeacher();
      allow create, delete: if isTeacher();
      allow update: if isTeacher() || (
        request.auth != null && request.auth.token.email == resource.data.email
      );
    }
    match /teacherInvites/{code} {
      // نفس نمط studentInvites لكن مقصور على المالك (isOwner) بدل أي معلّم — بوابة مكافحة التسلل
      // التي تمنع أي شخص من تسجيل نفسه كمعلّم دون كود صادر عن المالك صراحةً.
      allow get: if true;
      allow list: if isOwner();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        request.auth != null && request.auth.token.email == resource.data.email
      );
    }
    match /sessions/{sessionId} {
      allow create, delete: if isTeacher();
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || isTeacher());
      // الطالب يُسمح له بتحديث حقل quizPassed فقط في جلسته؛ أي حقل آخر يبقى حصرًا للمعلّم.
      allow update: if isTeacher() || (
        request.auth != null &&
        request.auth.uid == resource.data.studentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quizPassed', 'watchedAt'])
      );
    }
    match /quizzes/{quizId} {
      allow write: if isTeacher();
      allow read: if isTeacher() || (
        request.auth != null && (
          !('studentIds' in resource.data) ||
          resource.data.studentIds.hasAny([request.auth.uid])
        )
      );
    }
    match /notes/{noteId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.studentId;
    }
  }
}
